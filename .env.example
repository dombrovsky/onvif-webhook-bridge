# Optional Compose interpolation settings. No password belongs in this file.
# Default image tracks stable releases.
# latest is not currently published; prereleases never update it.
ONVIF_IMAGE=dombrovskyi/onvif-webhook-bridge:latest
ONVIF_ADMIN_USERNAME=admin
ONVIF_BOOTSTRAP_VOLUME=onvif-bridge-bootstrap
ONVIF_CONTAINER_PORT=8080
ONVIF_PUBLISHED_PORT=8080
# Keep loopback unless you have configured secure remote access.
ONVIF_BIND_ADDRESS=127.0.0.1
