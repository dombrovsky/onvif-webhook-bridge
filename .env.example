# Copy to ignored .env and replace these placeholders locally. No password here.
ONVIF_ADMIN_USERNAME=<administrator-name>
ONVIF_ADMIN_PASSWORD_PATH=./.local/administrator-password
ONVIF_IMAGE=onvif-webhook-bridge:local
ONVIF_CONTAINER_PORT=8080
ONVIF_PUBLISHED_PORT=8080
# Loopback is intentional; change only with an appropriate HTTPS setup.
ONVIF_BIND_ADDRESS=127.0.0.1
