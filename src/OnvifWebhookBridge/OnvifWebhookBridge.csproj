<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>../..</DockerfileContext>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SharpOnvifClient" Version="0.11.2" />
    <PackageReference Include="TaskFlow" Version="1.1.0-rc.10" />
    <InternalsVisibleTo Include="OnvifWebhookBridge.Tests" />
    <InternalsVisibleTo Include="OnvifWebhookBridge.NativeSmoke" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
    <EmbeddedResource Include="wwwroot/*" />
  </ItemGroup>
</Project>
